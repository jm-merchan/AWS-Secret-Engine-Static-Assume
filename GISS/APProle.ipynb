   "source": [
    "import time\n",
    "\n",
    "def run_with_timeout(func, timeout):\n",
    "    start_time = time.time()\n",
    "    while True:\n",
    "        func()\n",
    "        if time.time() - start_time > timeout:\n",
    "            break\n",
    "\n",
    "def my_task():\n",
    "    # Your task code here\n",
    "    print('Task is running...')\n",
    "\n",
    "run_with_timeout(my_task, 10)"
   ]
  }
